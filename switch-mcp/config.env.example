# Enfocus Switch MCP connector: configuration
#
# 1. Copy this file to:
#      macOS / Linux:  ~/.config/enfocus-switch-mcp/config.env
#      Windows:        %USERPROFILE%\.config\enfocus-switch-mcp\config.env
# 2. Fill in the REQUIRED values below.
# 3. macOS / Linux only: make it private (it holds a password):
#      chmod 600 ~/.config/enfocus-switch-mcp/config.env
# 4. Test it:  enfocus-switch-mcp check
#
# Format: KEY=value, one per line. Lines starting with # are ignored.
# Quotes around values are optional ("like this" or 'like this').
# Anything also set as an environment variable (for example in the Claude config) wins over this file.

# ---------------------------------------------------------------- REQUIRED

# Address of the Switch Web Services: scheme, host and port only, no path.
# The default Switch Web Services port is 51088. Use https:// if your Switch
# Web Services are behind TLS.
SWITCH_URL=http://switch-server.example.local:51088

# A Switch user created for this connector (Switch Designer > Users pane).
SWITCH_USERNAME=ai-connector

# That user's password. Choose ONE of:
SWITCH_PASSWORD=change-me
#   or keep the password in its own file (first line = password) and point to it:
# SWITCH_PASSWORD_FILE=~/.config/enfocus-switch-mcp/password.txt

# ---------------------------------------------------------------- PERMISSIONS
# Out of the box the connector is READ-ONLY. It can look at flows, jobs,
# reports and the message log, but it cannot change anything in Switch.

# true = allow: submit jobs, approve/reject (route) checkpoint jobs, replace
# job files, lock/unlock jobs, rush jobs.
SWITCH_ALLOW_WRITE=false

# true = allow starting and STOPPING flows. Keep false unless you really need it.
SWITCH_ALLOW_FLOW_CONTROL=false

# ---------------------------------------------------------------- LOCAL FILES

# Folders the connector may READ files from (to submit jobs, replace jobs,
# check PDFs, or explain report files). Leave empty to allow none.
# Separate several folders with ":" on macOS/Linux or ";" on Windows.
SWITCH_UPLOAD_DIRS=

# Where downloaded job files and preflight reports are saved.
# Default: a folder named switch-mcp-downloads in your home folder.
# SWITCH_DOWNLOAD_DIR=~/switch-mcp-downloads

# Largest file (in MB) the connector will read, upload or download. Default 500.
# SWITCH_MAX_FILE_MB=500

# ---------------------------------------------------------------- CONNECTION (optional)

# Seconds to wait for Switch before giving up. Raise it for large uploads. Default 60.
# SWITCH_TIMEOUT=60

# For https with an internal/company certificate authority: path to the CA
# certificate (PEM). Prefer this over turning verification off.
# SWITCH_CA_BUNDLE=/path/to/company-root-ca.pem

# true (default) = verify https certificates. false = don't (test servers only).
# SWITCH_VERIFY_TLS=true

# Language of Switch error messages: enUS, deDE, frFR, esES, itIT, jaJA, ptBR, zhCN.
# SWITCH_LANG=enUS

# Only if Enfocus ever changes the Web Services login key. Leave unset.
# SWITCH_PUBLIC_KEY_PATH=

# ---------------------------------------------------------------- AUTOMATIONS (all optional)
# See docs/ai-connector-research.md section 3 for what each one does.

# Which preflight issues your flow auto-fixes (copy autofix_map.example.json and edit).
# SWITCH_AUTOFIX_MAP=~/.config/enfocus-switch-mcp/autofix_map.json

# Name of the checkpoint connection that means "proof approved" (used by approve_proof).
# SWITCH_APPROVE_CONNECTION=Approve

# Job number formats in file names / emails: ";"-separated regexes, one (capture group) each.
# PACE_JOB_NUMBER_PATTERNS=\bJ(\d{6})\b;\b(\d{6})_

# Pace, READ-ONLY database access. Needs: uv tool install --reinstall './switch-mcp[pace]'
# Use a read-only database role, ideally on a replica. Fill in pace_queries.example.sql first.
# PACE_DB_DSN=postgresql://readonly_user:password@pace-db.example.local:5432/pace
# PACE_QUERIES_FILE=~/.config/enfocus-switch-mcp/pace_queries.sql
# Pace item template field names for estimate drafts (copy item_template_map.example.json).
# PACE_ITEM_TEMPLATE_MAP=~/.config/enfocus-switch-mcp/item_template_map.json
# Pace status to set when a proof is approved (approve_proof and POST /proof/approve).
# PACE_PROOF_APPROVED_STATUS=Proof Approved

# Pace WRITES through the Pace API (status changes and job notes). Off unless all of these are set.
# Copy pace_api.example.json and fill in the endpoints from your Pace API documentation.
# PACE_API_CONFIG=~/.config/enfocus-switch-mcp/pace_api.json
# PACE_API_URL=https://pace.example.local/rpc/rest/services
# PACE_API_USERNAME=automation
# PACE_API_PASSWORD=change-me
# true = actually send writes. false (default) = every Pace step is reported as "manual".
# PACE_ALLOW_WRITE=false
# The ONLY statuses automation may set (comma separated, exact Pace names). Required when writes are on.
# PACE_ALLOWED_STATUSES=Proof Approved,Proof Sent,Waiting on Customer

# Per-customer standing agreements (copy customer_rules.example.json).
# CUSTOMER_RULES=~/.config/enfocus-switch-mcp/customer_rules.json

# Preflight analytics: SQLite file (created automatically). Empty = off.
# ANALYTICS_DB=~/.config/enfocus-switch-mcp/analytics.sqlite
# ANALYTICS_RETENTION_DAYS=365

# Audit trail of automated changes (JSON lines). Empty = application log only.
# AUDIT_LOG=~/.config/enfocus-switch-mcp/audit.jsonl

# ---------------------------------------------------------------- AUTOMATION WEB SERVICE (optional)
# Only for the server that runs `enfocus-switch-mcp service` (see docs/handoff/deployment.md).

# Hashed API keys with scopes. Create keys with: enfocus-switch-mcp service-key --name portal --scopes preflight
# SERVICE_KEYS_FILE=/etc/enfocus-switch-mcp/service_keys.json
# Address and port. Keep 127.0.0.1 and put a reverse proxy with https in front for other machines.
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8765
# true (default) = plan every change but make none. Set false only after UAT sign-off.
# SERVICE_DRY_RUN=true
# What to do for each Switch event (copy service_status_map.example.json).
# SERVICE_STATUS_MAP=/etc/enfocus-switch-mcp/service_status_map.json
# true = route checkpoint jobs to the auto-fix branch when every issue is auto-fixable.
# SERVICE_AUTO_ROUTE=false
# Largest upload for POST /preflight, in MB. Requests per minute per API key.
# SERVICE_MAX_UPLOAD_MB=100
# SERVICE_RATE_LIMIT_PER_MIN=60
# Serve https directly (instead of a reverse proxy): both files, PEM.
# SERVICE_TLS_CERT=
# SERVICE_TLS_KEY=

# Morning digest: Teams/Slack incoming-webhook URL (https) and the "stuck" threshold in hours.
# DIGEST_WEBHOOK_URL=https://...
# DIGEST_STUCK_HOURS=4
