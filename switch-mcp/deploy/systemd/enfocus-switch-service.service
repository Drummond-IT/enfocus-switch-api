# Automation web service. Install: see docs/handoff/deployment.md, section 3.4.
[Unit]
Description=Enfocus Switch automation service (Drummond)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=switchmcp
Group=switchmcp
Environment=SWITCH_ENV_FILE=/etc/enfocus-switch-mcp/config.env
ExecStart=/opt/enfocus-switch-mcp/bin/enfocus-switch-mcp service
Restart=on-failure
RestartSec=5
# Hardening: the service only needs its data folder and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/enfocus-switch-mcp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=2G
TasksMax=256
UMask=0077

[Install]
WantedBy=multi-user.target
